{
  "name": "dsh-workspace-atlas",
  "version": "0.2.1",
  "description": "AGENTS & Skills Studio — edit global/workspace AGENTS.md, manage multiple SKILL.md files, and install skills from Anthropic, OpenAI, Cursor, and Matt Pocock catalogs in DSH.",
  "license": "MIT",
  "author": "Asteroid-Code-Channel",
  "repository": {
    "type": "git",
    "url": "https://github.com/Asteroid-Code-Channel/dsh-workspace-atlas.git"
  },
  "homepage": "https://github.com/Asteroid-Code-Channel/dsh-workspace-atlas#readme",
  "bugs": {
    "url": "https://github.com/Asteroid-Code-Channel/dsh-workspace-atlas/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agents-md",
    "skills",
    "skill-catalog",
    "workspace",
    "workspace-tree"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
